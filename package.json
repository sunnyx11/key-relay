{
  "name": "key-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:native-input": "cargo test --manifest-path src-tauri/Cargo.toml --test native_input -- --ignored --test-threads=1",
    "test:desktop": "playwright test --config playwright.native.config.ts",
    "lint": "eslint src tests scripts vite.config.ts playwright.config.ts playwright.native.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles nsis",
    "specs": "node .agents/skills/spec-coding/scripts/update-specs.mjs --root . --specs-dir docs && node .agents/skills/spec-coding/scripts/check-specs.mjs --root . --specs-dir docs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
